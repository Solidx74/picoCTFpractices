Complete Solution Script
python

#!/usr/bin/env python3
"""
Solution for PicoCTF "Timestamped Secrets" challenge
Author: Solidx74
Date: 2024
"""

import hashlib
from Crypto.Cipher import AES
import binascii

def decrypt_timestamp_secret(timestamp: int, ciphertext_hex: str) -> str:
    """
    Decrypt a message encrypted with a timestamp-derived key
    
    Args:
        timestamp: The Unix timestamp used for key generation
        ciphertext_hex: Hexadecimal ciphertext string
    
    Returns:
        Decrypted plaintext string
    """
    # Generate key from timestamp (same as encryption)
    key = hashlib.sha256(str(timestamp).encode()).digest()[:16]
    print(f"[*] Timestamp: {timestamp}")
    print(f"[*] Derived key (hex): {key.hex()}")
    
    # Convert hex ciphertext to bytes
    ciphertext = binascii.unhexlify(ciphertext_hex)
    print(f"[*] Ciphertext length: {len(ciphertext)} bytes")
    
    # Decrypt using AES-ECB
    cipher = AES.new(key, AES.MODE_ECB)
    plaintext_padded = cipher.decrypt(ciphertext)
    
    # Remove PKCS#7 padding
    pad_len = plaintext_padded[-1]
    plaintext = plaintext_padded[:-pad_len]
    
    return plaintext.decode()

def main():
    # Given data from the challenge
    timestamp = 1770242633
    ciphertext_hex = "6d8330b05a68848fdf4b7ab057cd6eb070810e3febd76872b4a5e7627221a396"
    
    try:
        flag = decrypt_timestamp_secret(timestamp, ciphertext_hex)
        print(f"\n[+] Success! Flag: {flag}")
    except Exception as e:
        print(f"[-] Error: {e}")

if __name__ == "__main__":
    main()

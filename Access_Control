Step 5: Reveal the Flag

Now that we're the owner, call the solve() function. Create solve.py:
python

from web3 import Web3
from eth_account import Account

w3 = Web3(Web3.HTTPProvider('http://lonely-island.picoctf.net:60474'))

private_key = '0x0230c5b326c0d10b182d1e47a7dc2c6c4c82883a9e42866766d8a5e9930842c0'
account = Account.from_key(private_key)
my_address = '0xd54Ad1b056cde127D02c9955C9F6e33B52f13Fcc'
contract_address = '0x6D8da4B12D658a36909ec1C75F81E54B8DB4eBf9'

# Call solve()
solve_data = '0x890d6908'  # solve() function signature
nonce = w3.eth.get_transaction_count(my_address)
chain_id = w3.eth.chain_id

transaction = {
    'to': contract_address,
    'value': 0,
    'gas': 100000,
    'gasPrice': w3.to_wei('1', 'gwei'),
    'nonce': nonce,
    'data': solve_data,
    'chainId': chain_id
}

signed = account.sign_transaction(transaction)
tx_hash = w3.eth.send_raw_transaction(signed.raw_transaction)
receipt = w3.eth.wait_for_transaction_receipt(tx_hash)

# Get the flag
flag_data = '0xf9633930'  # getFlag() function signature
flag_result = w3.eth.call({
    'to': contract_address,
    'data': flag_data
})

# Decode the flag
flag_hex = flag_result.hex()
# Skip offset (32 bytes) and length (32 bytes)
data_hex = flag_hex[128:]
flag = bytes.fromhex(data_hex).decode('utf-8').rstrip('\x00')
print(f"🏁 FLAG: {flag}")

Run it:
bash

python3 solve.py

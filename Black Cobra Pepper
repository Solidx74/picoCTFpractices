def hex_to_matrix(hex_str):
    """Convert 32-char hex string to 4x4 byte matrix"""
    bytes_list = [int(hex_str[i:i+2], 16) for i in range(0, 32, 2)]
    matrix = [[0]*4 for _ in range(4)]
    for i, b in enumerate(bytes_list):
        row = i % 4
        col = i // 4
        matrix[row][col] = b
    return matrix

def matrix_to_hex(matrix):
    """Convert 4x4 byte matrix back to hex string"""
    hex_str = ""
    for col in range(4):
        for row in range(4):
            hex_str += format(matrix[row][col], '02x')
    return hex_str

def xor_hex(a, b):
    """XOR two hex strings"""
    a_bytes = bytes.fromhex(a)
    b_bytes = bytes.fromhex(b)
    return bytes(x ^ y for x, y in zip(a_bytes, b_bytes)).hex()

def L_inverse(y_hex):
    """Compute L⁻¹(y)"""
    state = hex_to_matrix(y_hex)
    
    # Apply SR⁻¹ first
    state = inv_shift_rows(state)
    
    # Apply (SR⁻¹ ∘ MC⁻¹) 9 times
    for _ in range(9):
        state = inv_mix_columns(state)
        state = inv_shift_rows(state)
    
    return matrix_to_hex(state)

